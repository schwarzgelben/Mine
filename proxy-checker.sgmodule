#!name=策略组入口与落地检测
#!desc=检测指定策略组下所有子节点的落地 IP 与地区信息
#!category=Network Info
#!arguments=group:PROXY
#!arguments-desc=group: 需要检测的策略组名称（例如：PROXY、节点选择、Auto 等）

[Panel]
Proxy-Checker = script-name=proxy-checker, title="节点落地检测", content="点击刷新开始检测", style=info, update-interval=-1

[Script]
proxy-checker = type=generic, script-path=https://raw.githubusercontent.com/schwarzgelben/Mine/main/proxy-checker.js, argument=group={{{group}}}, timeout=30
