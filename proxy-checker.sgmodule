#!name=策略组全节点链路检测 (LSP)
#!desc=实时并发检测指定策略组下所有节点的入口 IP、落地 IP、国旗与 ASN 链路信息
#!category=Network Info
#!arguments=group:PROXY
#!arguments-desc=group: 需要检测的策略组名称（例如：PROXY、节点选择、Auto 等）

[Panel]
Proxy-LSP = script-name=proxy-lsp, title="节点链路检测", content="点击刷新开始检测", style=info, update-interval=-1

[Script]
proxy-lsp = type=generic, script-path=https://raw.githubusercontent.com/schwarzgelben/Mine/main/proxy-lsp.js, argument=group={{{group}}}, timeout=25
